<?xml version="1.0" encoding="utf-8"?>
<!-- A Makefile project rather than a C++ one: the build belongs to CMake and
     Ninja inside libKCD2's tree, and this project hands Build straight to
     tools\build_cpp.bat. What it adds is the part Visual Studio cannot infer
     from a batch file: the file tree, the include paths and defines IntelliSense
     needs, and a debug target.

     Paths that belong to one machine come from build.env beside the project,
     which the rest of the build reads too. -->
<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Release builds the plugin and nothing else, which is the loop while editing
       C++. Deploy runs the whole pipeline afterwards: the flash, the localization
       tables, the pak, and the copy into the game. -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Deploy|x64">
      <Configuration>Deploy</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{6B0A5C1E-3F7D-4E2A-9C48-0D1B7A5E9F30}</ProjectGuid>
    <Keyword>MakeFileProj</Keyword>
    <RootNamespace>SavegameRenamer</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Makefile</ConfigurationType>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <!-- The machine paths come out of build.env beside the project, the same file
       tools/buildenv.py and tools/build_cpp.bat read, so a path is written once
       for the whole build. An environment variable of the same name wins over
       it, and nothing here carries one developer's layout. -->
  <PropertyGroup Label="UserMacros">
    <BuildEnvFile>$(MSBuildProjectDirectory)\build.env</BuildEnvFile>
    <BuildEnvText Condition="Exists('$(BuildEnvFile)')">$([System.IO.File]::ReadAllText('$(BuildEnvFile)'))</BuildEnvText>

    <!-- Where the game is installed; the Deploy configuration starts it. -->
    <KCD2Root Condition="'$(KCD2Root)' == ''">$(KCD2_ROOT)</KCD2Root>
    <KCD2Root Condition="'$(KCD2Root)' == '' and '$(BuildEnvText)' != ''">$([System.Text.RegularExpressions.Regex]::Match($(BuildEnvText), 'KCD2_ROOT\s*=\s*([^\r\n]*)').Groups.get_Item(1).Value.Trim())</KCD2Root>

    <!-- The reverse-engineered headers and the build environment this project is
         a subproject of. -->
    <LibKCD2Root Condition="'$(LibKCD2Root)' == ''">$(LIBKCD2_ROOT)</LibKCD2Root>
    <LibKCD2Root Condition="'$(LibKCD2Root)' == '' and '$(BuildEnvText)' != ''">$([System.Text.RegularExpressions.Regex]::Match($(BuildEnvText), 'LIBKCD2_ROOT\s*=\s*([^\r\n]*)').Groups.get_Item(1).Value.Trim())</LibKCD2Root>
    <LibKCD2Root Condition="'$(LibKCD2Root)' == ''">$(MSBuildProjectDirectory)\..\_deps\libKCD2</LibKCD2Root>
    <LibKCD2Build>$(LibKCD2Root)\.buildenv\build-release</LibKCD2Build>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Overridable for an interpreter that is not on PATH. -->
    <PythonExe Condition="'$(PythonExe)' == ''">python</PythonExe>

    <BuildCpp>"$(MSBuildProjectDirectory)\tools\build_cpp.bat"</BuildCpp>
    <BuildMod>"$(PythonExe)" "$(MSBuildProjectDirectory)\tools\build.py" --deploy</BuildMod>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <NMakeBuildCommandLine>$(BuildCpp)</NMakeBuildCommandLine>
    <NMakeReBuildCommandLine>$(BuildCpp)</NMakeReBuildCommandLine>
  </PropertyGroup>

  <!-- Sequenced rather than written on two lines: the pipeline copies the plugin
       it has just built, so it must not run when the compile failed. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Deploy'">
    <NMakeBuildCommandLine>$(BuildCpp) &amp;&amp; $(BuildMod)</NMakeBuildCommandLine>
    <NMakeReBuildCommandLine>$(BuildCpp) &amp;&amp; $(BuildMod)</NMakeReBuildCommandLine>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Clean is deliberately inert: the build directory is libKCD2's and holds
         every other plugin built from that tree. -->
    <NMakeCleanCommandLine>echo Clean is not wired: the build tree belongs to libKCD2.</NMakeCleanCommandLine>
    <NMakeOutput>$(LibKCD2Build)\SavegameRenamer\SavegameRenamer.dll</NMakeOutput>

    <!-- IntelliSense only. The compiler gets these from CMake. -->
    <NMakePreprocessorDefinitions>_ITERATOR_DEBUG_LEVEL=0;WIN32_LEAN_AND_MEAN;NOMINMAX;WIN32;_WIN64;NDEBUG;$(NMakePreprocessorDefinitions)</NMakePreprocessorDefinitions>
    <NMakeIncludeSearchPath>$(MSBuildProjectDirectory)\cpp\include;$(MSBuildProjectDirectory)\cpp\src;$(MSBuildProjectDirectory)\cpp\tests;$(LibKCD2Root)\include;$(LibKCD2Root)\include\CryEngine\CryCommon;$(LibKCD2Build)\vcpkg_installed\x64-windows-static-md\include;$(NMakeIncludeSearchPath)</NMakeIncludeSearchPath>
    <AdditionalOptions>/std:c++17 /utf-8</AdditionalOptions>
  </PropertyGroup>

  <!-- Each configuration starts what it has just built. Release stops at the
       plugin and the tests, and the game it could otherwise start would be
       running whichever plugin was installed last, not the one on screen. -->
  <PropertyGroup Label="Debugging">
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'" Label="Debugging">
    <LocalDebuggerCommand>$(LibKCD2Build)\SavegameRenamer\SavegameRenamerTests.exe</LocalDebuggerCommand>
    <LocalDebuggerWorkingDirectory>$(LibKCD2Build)\SavegameRenamer</LocalDebuggerWorkingDirectory>
  </PropertyGroup>

  <!-- The plugin is loaded into the game by KCSE, so the thing to start is the
       game. Breakpoints bind once it has loaded the DLL. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Deploy'" Label="Debugging">
    <LocalDebuggerCommand>$(KCD2Root)\Bin\Win64MasterMasterSteamPGO\KingdomCome.exe</LocalDebuggerCommand>
    <LocalDebuggerWorkingDirectory>$(KCD2Root)\Bin\Win64MasterMasterSteamPGO</LocalDebuggerWorkingDirectory>
  </PropertyGroup>

  <!-- Wildcards and/or some other MSBuild constructs used in project item definitions are not supported in VC projects. -->
  <ItemGroup>
	<ClCompile Include="cpp\src\plugin.cpp" />
    <ClCompile Include="cpp\src\game\RenameDialog.cpp" />
    <ClCompile Include="cpp\src\game\RenameFlow.cpp" />
	<ClCompile Include="cpp\src\game\SaveCatalog.cpp" />
	<ClCompile Include="cpp\src\game\SaveLoadHook.cpp" />
	<ClCompile Include="cpp\src\game\Strings.cpp" />
	<ClCompile Include="cpp\src\whs\Description.cpp" />
	<ClCompile Include="cpp\src\whs\Sanitise.cpp" />
    <ClCompile Include="cpp\tests\DescriptionRead.cpp" />
    <ClCompile Include="cpp\tests\DescriptionSafety.cpp" />
	<ClCompile Include="cpp\tests\DescriptionRename.cpp" />
	<ClCompile Include="cpp\tests\DescriptionWrite.cpp" />
	<ClCompile Include="cpp\tests\RealSave.cpp" />
	<ClCompile Include="cpp\tests\Sanitise.cpp" />
  </ItemGroup>

  <ItemGroup>
	<ClInclude Include="cpp\src\Log.h" />
    <ClInclude Include="cpp\include\whs\Description.h" />
	<ClInclude Include="cpp\include\whs\Sanitise.h" />
    <ClInclude Include="cpp\src\game\Hook.h" />
    <ClInclude Include="cpp\src\game\RenameDialog.h" />
    <ClInclude Include="cpp\src\game\RenameFlow.h" />
	<ClInclude Include="cpp\src\game\SaveCatalog.h" />
	<ClInclude Include="cpp\src\game\SaveLoadHook.h" />
	<ClInclude Include="cpp\src\game\Strings.h" />
    <ClInclude Include="cpp\tests\TestFixture.h" />
  </ItemGroup>

  <ItemGroup>
    <None Include="flash\renamer.as" />
    <None Include="flash\base.xml" />
    <None Include="src\Localization\strings.xml" />
    <None Include="src\Data\Libs\UI\UIElements\SavegameRenamer.xml" />
    <None Include="src\mod.manifest" />
    <None Include="cpp\.buildenv\CMakeLists.txt" />
    <None Include="tools\build.py" />
	<None Include="tools\buildenv.py" />
	<None Include="tools\build_flash.py" />
	<None Include="tools\build_localization.py" />
	<None Include="tools\pak.py" />
	<None Include="tools\project.py" />
    <None Include="tools\build_cpp.bat" />
    <None Include="prototypes\whs_header.py" />
    <None Include="prototypes\README.md" />
    <None Include="docs\2026-08-17-savegame-renamer-design.md" />
	<None Include="docs\2026-08-17-savegame-renamer-plan.md" />
    <None Include="docs\2026-08-19-refactoring-design.md" />
    <None Include="docs\nexus\description.bbcode.txt" />
    <None Include="docs\nexus\make_art.py" />
    <None Include="README.md" />
    <None Include="build.env.example" />
	<None Include=".gitignore" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
