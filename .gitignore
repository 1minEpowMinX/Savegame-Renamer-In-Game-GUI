build/
vcpkg_installed/
releases/*.zip
__pycache__/
*.pyc

# Visual Studio's own workspace state: window layout, IntelliSense caches, the
# Copilot symbol index. Machine-local and regenerated on open.
.vs/
out/
*.user
CMakeUserPresets.json
CppProperties.json

# One machine's paths; build.env.example is the tracked description of it.
build.env

# MSBuild's intermediate directory for the project, created next to it as
# <project>/<platform>/<configuration> the first time it evaluates the build.
/SavegameRenamer/
[Xx]64/
[Dd]ebug/
[Rr]elease/

# Language-server leftovers, should another editor be pointed at the tree.
.cache/
compile_commands.json
