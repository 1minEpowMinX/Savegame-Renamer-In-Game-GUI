# Machine paths the build needs. Copy to build.env and fill in; build.env is not
# tracked, so nobody else inherits one developer's layout.
#
# Read by tools/buildenv.py and by tools/build_cpp.bat. A variable already set in
# the environment wins over the value here.
#
# Quotes are optional and stripped; do not put a trailing backslash on a path.

# Where the game is installed. --deploy copies here, and Visual Studio starts the
# executable under it when you press F5 in the Deploy and Release configurations.
KCD2_ROOT=C:\Program Files (x86)\Steam\steamapps\common\KingdomComeDeliverance2

# libKCD2 checked out. Its .buildenv is the CMake root this project builds under,
# and its include tree is what the plugin compiles against.
LIBKCD2_ROOT=C:\dev\KCD2\_deps\libKCD2

# vcpkg checked out. libKCD2's CMake uses it in manifest mode.
VCPKG_ROOT=C:\dev\KCD2\_deps\vcpkg

# The Visual Studio installation whose vcvars64.bat and Ninja the build uses.
VS_ROOT=C:\Program Files\Microsoft Visual Studio\2022\Community

# JPEXS Free Flash Decompiler, which compiles the dialog. It has no standard
# install location.
FFDEC=C:\Program Files\FFDec\ffdec-cli.exe
