<?xml version="1.0" encoding="UTF-8"?>
<!-- SWF skeleton for the rename dialog, converted by FFDec (-xml2swf) and then
     filled with renamer.as (-importScript).

     The dialog draws itself from ActionScript, so the only thing that cannot be
     expressed there is the font: a text field renders nothing unless the movie
     imports a font from the game's shared library. Both weights the vanilla
     menu uses are imported here, under the same character ids the game's own
     Menu.gfx assigns them.

     Stage is 800x450 px (16000x9000 twips), matching the coordinate space
     renamer.as lays out in. -->
<swf _xmlExportMajor="2" _xmlExportMinor="2" type="SWF" charset="UTF-8" compression="ZLIB" encrypted="false" frameCount="1" frameRate="30.0" gfx="false" hasEndTag="true" version="8">
  <displayRect type="RECT" Xmax="16000" Xmin="0" Ymax="9000" Ymin="0" nbits="14"/>
  <tags>

    <item type="FileAttributesTag" actionScript3="false" forceWriteAsLong="false" hasMetadata="false" noCrossDomainCache="false" reservedA="false" reservedB="0" swfRelativeUrls="false" useDirectBlit="false" useGPU="false" useNetwork="false"/>

    <item type="SetBackgroundColorTag" forceWriteAsLong="false">
      <backgroundColor type="RGB" blue="0" green="0" red="0"/>
    </item>

    <item type="ImportAssets2Tag" downloadNow="1" forceWriteAsLong="true" hasDigest="0" url="gfxfontlib.gfx">
      <tags>
        <item>100</item>
      </tags>
      <names>
        <item>DefaultFont</item>
      </names>
    </item>

    <item type="ImportAssets2Tag" downloadNow="1" forceWriteAsLong="true" hasDigest="0" url="gfxfontlib.gfx">
      <tags>
        <item>101</item>
      </tags>
      <names>
        <item>DefaultFontBold</item>
      </names>
    </item>

    <item type="ImportAssets2Tag" downloadNow="1" forceWriteAsLong="true" hasDigest="0" url="gfxfontlib.gfx">
      <tags>
        <item>102</item>
      </tags>
      <names>
        <item>DisplayFont</item>
      </names>
    </item>

    <!-- The window frame is the game's own modal-dialog texture. ApseModalDialog.gfx
         exports it as a symbol, so it is imported exactly the way the fonts above
         are: a tag FFDec writes itself, with nothing patched into the binary
         afterwards. The engine loads it from Libs/UI, so no game asset ships with
         the mod.

         An imported texture is a bitmap character and cannot be attached as a
         movie clip; every vanilla screen uses one as a shape fill instead. So a
         shape fills itself with it, a sprite wraps the shape, and ActionScript
         attaches the sprite.

         Geometry is in twips, 20 per pixel: the shape is 520x260 px and the fill
         matrix maps the 1024x512 texture onto it (20 * 520 / 1024). -->

    <item type="ImportAssets2Tag" downloadNow="1" forceWriteAsLong="true" hasDigest="0" url="ApseModalDialog.gfx">
      <tags>
        <item>200</item>
      </tags>
      <names>
        <item>Textures/Apse/modal_dialog_simple</item>
      </names>
    </item>

    <item type="DefineShapeTag" forceWriteAsLong="true" shapeId="201">
      <shapeBounds type="RECT" Xmax="10400" Xmin="0" Ymax="5200" Ymin="0" nbits="16"/>
      <shapes type="SHAPEWITHSTYLE" numFillBits="1" numLineBits="0">
        <fillStyles type="FILLSTYLEARRAY">
          <fillStyles>
            <item type="FILLSTYLE" bitmapId="200" fillStyleType="65">
              <bitmapMatrix type="MATRIX" hasRotate="false" hasScale="true" nRotateBits="0" nScaleBits="22" nTranslateBits="0" scaleX="10.15625" scaleY="10.15625" translateX="0" translateY="0"/>
            </item>
          </fillStyles>
        </fillStyles>
        <lineStyles type="LINESTYLEARRAY">
          <lineStyles/>
        </lineStyles>
        <shapeRecords>
          <item type="StyleChangeRecord" fillStyle1="1" moveBits="16" moveDeltaX="10400" moveDeltaY="5200" stateFillStyle0="false" stateFillStyle1="true" stateLineStyle="false" stateMoveTo="true" stateNewStyles="false"/>
          <item type="StraightEdgeRecord" deltaX="-10400" generalLineFlag="false" numBits="16" vertLineFlag="false"/>
          <item type="StraightEdgeRecord" deltaY="-5200" generalLineFlag="false" numBits="16" vertLineFlag="true"/>
          <item type="StraightEdgeRecord" deltaX="10400" generalLineFlag="false" numBits="16" vertLineFlag="false"/>
          <item type="StraightEdgeRecord" deltaY="5200" generalLineFlag="false" numBits="16" vertLineFlag="true"/>
          <item type="EndShapeRecord" endOfShape="0"/>
        </shapeRecords>
      </shapes>
    </item>

    <item type="DefineSpriteTag" forceWriteAsLong="true" frameCount="1" hasEndTag="true" spriteId="202">
      <subTags>
        <item type="PlaceObject2Tag" characterId="201" clipDepth="0" depth="1" forceWriteAsLong="true" placeFlagHasCharacter="true" placeFlagHasClipActions="false" placeFlagHasClipDepth="false" placeFlagHasColorTransform="false" placeFlagHasMatrix="true" placeFlagHasName="false" placeFlagHasRatio="false" placeFlagMove="false" ratio="0">
          <matrix type="MATRIX" hasRotate="false" hasScale="false" nRotateBits="0" nScaleBits="0" nTranslateBits="0" rotateSkew0="0.0" rotateSkew1="0.0" scaleX="0.0" scaleY="0.0" translateX="0" translateY="0"/>
        </item>
        <item type="ShowFrameTag" forceWriteAsLong="false"/>
      </subTags>
    </item>

    <item type="ExportAssetsTag" forceWriteAsLong="true">
      <tags>
        <item>202</item>
      </tags>
      <names>
        <item>RenamerFrame</item>
      </names>
    </item>

    <!-- "0700" is stop() followed by the end-of-actions byte. The build replaces
         the whole tag with the compiled renamer.as. -->
    <item type="DoActionTag" actionBytes="0700" forceWriteAsLong="false"/>

    <item type="ShowFrameTag" forceWriteAsLong="false"/>
    <item type="EndTag" forceWriteAsLong="false"/>

  </tags>
</swf>
